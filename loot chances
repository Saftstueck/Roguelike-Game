using UnityEngine;

public class LootChances : MonoBehaviour
{
    void Start()
    {
        string loot = GetRandomLoot();
        Debug.Log(loot);
    }

    string GetRandomLoot()
    {
        int random = Random.Range(1, 5001); // 5000 total weight

        // 10 common items (1 weight each = 490 total, ~9.8% each)
        if (random <= 490) return "Common Sword";
        if (random <= 980) return "Common Shield";
        if (random <= 1470) return "Common Armor";
        if (random <= 1960) return "Common Potion";
        if (random <= 2450) return "Common Ring";
        if (random <= 2940) return "Common Boots";
        if (random <= 3430) return "Common Gloves";
        if (random <= 3920) return "Common Helmet";
        if (random <= 4410) return "Common Amulet";
        if (random <= 4900) return "Common Cloak";
        
        // 1 rare item (100 weight = 2% chance, 50x rarer)
        return "Legendary Artifact";
    }
}
